{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: [
    "alexander-hughes fleet preset v2 (2026-09-28). Holds ONLY what is true for every repo; anything",
    "about one repo lives in that repo's .renovaterc.json5 (its rules come after these and win on the",
    "keys they set). Sections are ordered so precedence reads top to bottom. No schedules: everything opens",
    "when its bake age is met and merges on green (tier A) or when a human clicks (2026-09-28 ruling).",
  ],

  // ══ §1 Platform behaviour ══════════════════════════════════════════════════════════════════
  extends: [
    // best-practices = recommended + docker:pinDigests + helpers:pinGitHubActionDigests + :configMigration
    // + :pinDevDependencies + abandonments:recommended + security:minimumReleaseAgeNpm (3 d) + weekly
    // lockfile maintenance (mise lockfiles; not on the ladder, so human merge).
    "config:best-practices",
    "docker:enableMajor",
    // Keeps the `# vX.Y.Z` comment beside a SHA pin updatable as semver.
    "helpers:pinGitHubActionDigestsToSemver",
    // PR automerge, not branch automerge: no repo runs CI on bare renovate/* branches, so branch mode
    // never saw a check and waited 25 h before opening a PR anyway. PRs also leave a record.
    ":automergePr",
    ":dependencyDashboard",
    ":semanticCommits",
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard :robot:",
  timezone: "America/New_York",
  ignorePaths: ["**/*.sops.*", "**/_template/**"],
  // Flow, don't batch (operator ruling 2026-09-28 after the first live wave). No cap on open PRs: human-tier
  // PRs that wait would otherwise fill the cap and starve tier A (home-ops sat at 10/10 with 12 more
  // rate-limited that evening). Two PR creations per hour — Renovate's default — is the only smoothing:
  // an incident traces back to at most two merges in any hour, and a burst after a preset change drains
  // at a readable pace. Vulnerability fixes have their own budget and skip the line.
  prConcurrentLimit: 0,
  prHourlyLimit: 2,
  // Only waits on REQUIRED checks: inert on Free-plan private repos (no rulesets), live once a ruleset
  // requires the `ci` check (public repos on Free, private repos on Pro).
  platformAutomerge: true,
  // Keep every PR, human tier included, current with its base so CI tests what would merge. The
  // conflicted-only setting (2026-09-28) guarded against a rebase cascade when Renovate merged one PR
  // per run; with platform automerge GitHub merges each PR minutes after CI goes green.
  rebaseWhen: "behind-base-branch",
  // A release with no releaseTimestamp is treated as stable instead of waiting forever. Digest
  // pinning is the primary control for those ecosystems; the bake is secondary.
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // OSV covers npm/pypi datasources. GitHub Dependabot alerts (enable per repo) cover Actions/pip/npm
  // — NOT Helm charts or container images in Flux manifests; their fast path is a dashboard checkbox.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ["security"],
    minimumReleaseAge: null,
  },

  // ══ §2 Managers that every repo uses ═══════════════════════════════════════════════════════
  "pre-commit": {
    enabled: true,
  },
  customManagers: [
    {
      description: "Annotated dependencies: `# renovate: datasource=X depName=Y [repository=U] [versioning=V] [extractVersion=R]` above a `key: value` / `key=value` line; the value may be quoted. No `: ` or `=` in a trailing comment on that line (the match is greedy).",
      customType: "regex",
      managerFilePatterns: ["/(^|/).+\\.env(?:\\.j2)?$/", "/(^|/).+\\.sh(?:\\.j2)?$/", "/(^|/).+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?( versioning=(?<versioning>\\S+))?( extractVersion=(?<extractVersion>\\S+))?\\n.+(:\\s|=\\s?)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{/if}}",
      extractVersionTemplate: "{{#if extractVersion}}{{{extractVersion}}}{{/if}}",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["oci://(?<depName>[^:]+):(?<currentValue>\\S+)"],
      datasourceTemplate: "docker",
    },
  ],

  packageRules: [
    // ══ §3 Fail-safe defaults — nothing below automerges unless §4 says so ═════════════════════
    {
      // Tier labels ride the NON-mergeable `labels` list (last matching rule wins), so a consumer's
      // later human rule replaces `tier/auto` with `tier/human` instead of accumulating both.
      // Default is human; §4 flips it to auto. `type/<updateType>` travels in the same list.
      description: "Default tier: human",
      matchPackageNames: ["*"],
      labels: ["type/{{updateType}}", "tier/human"],
    },
    {
      description: "Majors are always a human decision",
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["type/{{updateType}}", "tier/human"],
    },
    {
      description: "0.x minors can break at any time (semver) — human. §4 minor rules exclude 0.x so this stands.",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      automerge: false,
      labels: ["type/{{updateType}}", "tier/human"],
    },
    {
      // custom.regex captures currentValue only (no currentDigest group), so pinDigests produces
      // "Error updating branch: update failure". Native managers do the digest pinning.
      description: "Skip digest pin for custom.regex — capture has no currentDigest",
      matchManagers: ["custom.regex"],
      pinDigests: false,
    },

    // ══ §4 App ladder — patch/digest 3 d automerge, minor 7 d automerge at ≥1.0 ════════════════
    // (a) by datasource: container images, Helm charts (OCI charts are docker-datasource), pypi, npm
    {
      description: "app ladder (datasources) patch/digest/pin — 3 d automerge",
      matchDatasources: ["docker", "helm", "pypi", "npm"],
      matchUpdateTypes: ["patch", "digest", "pin", "pinDigest"],
      minimumReleaseAge: "3 days",
      automerge: true,
      labels: ["type/{{updateType}}", "tier/auto"],
    },
    {
      description: "app ladder (datasources) minor ≥1.0 — 7 d automerge",
      matchDatasources: ["docker", "helm", "pypi", "npm"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^v?0\\./",
      minimumReleaseAge: "7 days",
      automerge: true,
      labels: ["type/{{updateType}}", "tier/auto"],
    },
    // (b) by manager: CLI pins, hook revs, action pins (github-tags / github-releases / aqua datasources)
    {
      description: "app ladder (tooling managers) patch/digest/pin — 3 d automerge",
      matchManagers: ["mise", "pre-commit", "github-actions"],
      matchUpdateTypes: ["patch", "digest", "pin", "pinDigest"],
      minimumReleaseAge: "3 days",
      automerge: true,
      labels: ["type/{{updateType}}", "tier/auto"],
    },
    {
      description: "app ladder (tooling managers) minor ≥1.0 — 7 d automerge",
      matchManagers: ["mise", "pre-commit", "github-actions"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^v?0\\./",
      minimumReleaseAge: "7 days",
      automerge: true,
      labels: ["type/{{updateType}}", "tier/auto"],
    },

    // ══ §5 Commit messages and labels ═══════════════════════════════════════════════════════════
    {
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}})!:",
      commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )",
    },
    { matchUpdateTypes: ["minor"], semanticCommitType: "feat", commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )" },
    { matchUpdateTypes: ["patch"], semanticCommitType: "fix", commitMessageExtra: "( {{currentVersion}} ➔ {{newVersion}} )" },
    { matchUpdateTypes: ["digest"], semanticCommitType: "chore", commitMessageExtra: "( {{currentDigestShort}} ➔ {{newDigestShort}} )" },
    { matchDatasources: ["docker"], semanticCommitScope: "container", commitMessageTopic: "image {{depName}}" },
    { matchDatasources: ["helm"], semanticCommitScope: "helm", commitMessageTopic: "chart {{depName}}" },
    { matchManagers: ["github-actions"], semanticCommitType: "ci", semanticCommitScope: "github-action", commitMessageTopic: "action {{depName}}" },
    { matchDatasources: ["github-releases"], semanticCommitScope: "github-release", commitMessageTopic: "release {{depName}}" },
    { matchManagers: ["mise"], semanticCommitScope: "mise", commitMessageTopic: "tool {{depName}}" },
    { matchDatasources: ["docker"], addLabels: ["renovate/container"] },
    { matchDatasources: ["helm"], addLabels: ["renovate/helm"] },
    { matchManagers: ["github-actions"], addLabels: ["renovate/github-action"] },
    { matchDatasources: ["github-releases"], addLabels: ["renovate/github-release"] },
  ],
}
